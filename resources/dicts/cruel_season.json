            },
            "card_art": "environment/lean_meat.png"
        },
        "tooth_and_claw": {
            "name": "Tooth and Claw",
            "category": "Danger",
            "description": "War greatly increases the risk of injuries and deaths.",
            "modifiers": {
                "condition_related.war_injury_modifier": 235,
                "death_related.war_death_modifier": 340,
                "death_related.war_death_modifier_leader": 46
