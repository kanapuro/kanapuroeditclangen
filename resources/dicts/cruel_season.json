            "card_art": "danger/tooth_and_claw.png"
        },
        "miasma": {
            "name": "Miasma",
            "category": "Danger",
            "description": "Random illnesses are more frequent.",
            "modifiers": {
                "condition_related.expanded_illness_chance": 175
            },
            "card_art": "danger/miasma.png"
        },
        "burnout": {
            "name": "Burnout",
            "category": "Behavior",
            "description": "Base medical capacity is reduced from 10 to 5. Experience and healing skills still improve how many cats medicine cats can care for.",
            "card_art": "behavior/burnout.png",
            "modifiers": {
                "condition_related.medcats.medcat_base_capacity": 5
            }
        },
        "longer_illnesses": {
            "name": "Longer Illnesses",
            "category": "Environment",
            "description": "Illnesses last twice as long, including with medicine-cat care. Injuries are unaffected; herbs can still shorten recovery.",
            "card_art": "environment/tainted.png",
            "modifiers": {
                "condition_related.duration_modifier": 2,
                "condition_related.duration_modifier_tags": [
                    "illness"
                ]
            }
        },
        "plague_ridden": {
            "name": "Plague Ridden",
            "category": "Danger",
            "description": "Illness outbreaks can occur in any season and spread further through the colony. Medicine cats cannot reduce the chance of an outbreak.",
            "card_art": "danger/tooth_and_claw.png",
