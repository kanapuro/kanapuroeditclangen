        "clumsy_paws": {
            "name": "Clumsy Paws",
            "category": "Behavior",
            "description": "Experience and skill gains slow as cats approach their maximum. Small gains can still improve skills and training.",
            "card_art": "behavior/sorrow.png",
            "modifiers": {
                "progress.difficulty_modifier": 0.5
            }
        },
        "survival_of_fittest": {
            "name": "Survival of the Fittest",
            "category": "Society",
            "description": "Hunters are fed first, then cats with more experience. Feeding priorities are locked and manual meals are disabled.",
            "modifiers": {
                "prey.feeding.lock_order": true,
                "prey.feeding.lock_priority": true,
                "prey.feeding.allow_manual_feeding": false,
                "prey.feeding.priorities": [
                    "hunter first",
                    "more experience first"
                ]
            },
            "card_art": "society/survival_of_fittest.png"
        },
        "weak_stars": {
            "name": "Weakened Stars",
            "category": "Behavior",
            "description": "Each new leader receives one to five lives. Their grant is saved and cannot be increased by changing life settings.",
            "modifiers": {
                "death_related.max_leader_lives": 5,
                "death_related.min_leader_lives": 1
            },
            "card_art": "behavior/weakened_stars.png"
        },
        "forsaken": {
            "name": "Forsaken",
            "category": "Behavior",
            "description": "Leaders receive only one life, including successors. Colony and individual life settings cannot grant extra lives.",
            "modifiers": {
                "death_related.max_leader_lives": 1,
                "death_related.min_leader_lives": 1
            },
            "card_art": "behavior/forsaken.png"
        },
        "mate_breakup": {
            "name": "Not Made To Last",
            "category": "Behavior",
            "description": "Mates are more likely to break up. Only exceptionally strong overall bonds protect them; both partners\u2019 feelings and existing relationship controls still matter.",
            "modifiers": {
                "mates.breakup.initial_chance.threshold": 360,
                "mates.breakup.initial_chance.default_chance": 15
            },
            "card_art": "behavior/sorrow.png"
        },
        "crowfood": {
            "name": "Crowfood Chaos",
            "category": "Environment",
            "description": "Fresh prey rots at the next timeskip, before automatic feeding. Feed cats manually before skipping a moon. Cannot combine with Survival of the Fittest.",
            "modifiers": {
                "prey.time_to_rot": 1
            },
            "card_art": "environment/lean_meat.png"
        },
        "for_the_throne": {
            "name": "Anything For The Throne",
            "category": "Danger",
            "description": "Deputies have more negative interactions with leaders, lose respect more often, prefer eligible leaders as murder targets and are more likely to attack them.",
            "card_art": "danger/for_the_throne.png",
            "modifiers": {
                "death_related.murder.deputy_murder_modifier": 40,
                "relationship.deputy_to_leader_neg_buff": true,
                "relationship.deputy_envy_leader_influence": 3,
                "death_related.murder.deputy_prefer_leader": true
            }
        },
        "heartless": {
            "name": "Heartless",
            "category": "Behavior",
            "description": "New mate bonds cannot form automatically, and manual mate changes are disabled. Existing mates and family history remain; feelings and parentage follow their usual rules.",
            "card_art": "behavior/sorrow.png",
            "modifiers": {
                "mates.allow_manual": false,
                "mates.allow_mating": false
            }
        }
    },
